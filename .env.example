# J-Quants API V2 (APIキー認証)
# ダッシュボード(https://jpx-jquants.com/ja/dashboard)で発行したAPIキーをセット
JQUANTS_API_KEY=your_api_key_here

# EDINET API v2 (Subscription Key)
# https://disclosure2.edinet-fsa.go.jp/weee0030.aspx で無料発行
EDINET_API_KEY=your_edinet_subscription_key_here

# MariaDB接続情報
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stockuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=stock_research

# GitHub Actions self-hosted runner 用 PAT (NAS 側でのみ必要)
# GitHub > Settings > Developer settings > Personal access tokens > Fine-grained tokens
#   - Repository access: Only select repositories → deltaebisen/stock のみ
#   - Repository permissions: Administration = Read and write
# 設定後: ./setup-runner.sh deltaebisen/stock
RUNNER_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx
